# Local development environment (D-66). Copy to .env and set real values.
# .env is gitignored — never commit real credentials (SEC-17).
#
# Every variable docker-compose.yml reads is declared here. `make env-check` has
# no equivalent yet, so the invariant is asserted in CI instead — a variable used
# by compose and missing here fails the build rather than surfacing as an empty
# value at runtime.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis holds sessions, cache, queues, rate limiting and locks (§14.2).
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Meilisearch ───────────────────────────────────────────────────────────────
# Deferred to Module 15 (D-48) but runs from day one: ST-02 puts it in the boot
# order and BK-01 in the backup set. MEILI_ENV=production requires a key of at
# least 16 bytes.
MEILI_MASTER_KEY=
MEILI_PORT=7700

# ── Web ───────────────────────────────────────────────────────────────────────
HTTP_PORT=8080
HTTPS_PORT=8443

# ── File storage (§17) ────────────────────────────────────────────────────────
# Attachments are stored OUTSIDE the application directory, and nginx never
# mounts this path, so files cannot be reached by URL. §17 requires each one to
# be served through a permission-checking API instead.
# Layout underneath: /{year}/{month}/{entity_type}/{entity_id}/{uuid}.ext
STORAGE_PATH=/var/crm-files
