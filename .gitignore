# OS
.DS_Store
Thumbs.db

# Secrets — SEC-17: secrets never live in source
.env
.env.*
!.env.example
*.pem
*.key

# Claude Code — personal, not shared with the team
.claude.local.md
.claude/settings.local.json

# Logs and temp
*.log
tmp/
temp/

# Uploaded files — D-38/§17: stored outside the web root, never committed
# Scoped to this repository's own root. Unanchored, this also swallowed
# crm/storage — the Laravel application anchors those directories with its
# own .gitignore files, and hiding them left a fresh checkout with no
# storage/framework/views, which Laravel refuses to boot without.
/storage/
uploads/

# Backups — §16.3: kept on a separate machine/disk, never in git
backups/
*.dump
*.sql.gz

# Obsidian was removed from the project — ignore the whole folder so that
# opening the repo in the app never re-adds its config to git
.obsidian/

# ملفات حالة plugins — مش جزء من المشروع
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version

# Laravel application — its own .gitignore covers vendor/, .env and build output
crm/.env
