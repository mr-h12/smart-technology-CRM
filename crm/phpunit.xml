<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against PostgreSQL, not sqlite.

             The skeleton ships DB_CONNECTION=sqlite with :memory:, which would
             have made every database test meaningless here. sqlite's column
             types are advisory: NUMERIC(18,6) is stored as a double, so
             999999999999.123456 comes back as 999999999999.1234 — silently
             truncated — and NUMERIC(4,2) accepts 123456.789 without complaint.
             PostgreSQL keeps the first exactly and rejects the second with a
             numeric field overflow.

             D-68 fixes money at NUMERIC(18,6) and DB-07 forbids float anywhere
             near a price, so testing that on sqlite would prove nothing while
             looking green. Section 14.2 also relies on JSONB and partitioning
             (DB-10), and Module 3 on ILIKE — none of which sqlite has.

             DB_DATABASE is overridden so a test run cannot touch development
             data, and force="true" is not optional for that. PHPUnit's <env>
             only sets a variable that is not already set, and the compose stack
             injects DB_DATABASE into the container — so without it the suite
             silently ran against the development database. It passed either
             way, which is exactly what made it dangerous: the first test using
             RefreshDatabase would have truncated development data. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="crm_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Redis database 15, forced, because `docker compose up -d` runs the
             four worker containers (point 8.1) and they drain queues:critical
             and friends on database 0 right now. A queue test sharing that
             database is a race against a container that will happily execute
             the job first, and RealQueueExecutionTest flushes what it uses. -->
        <env name="REDIS_DB" value="15" force="true"/>
        <!-- And the cache connection, for the same reason. It defaults to
             database 1, which is where the running application caches: point
             8.3's probe wrote and deleted a key there before this was added.
             Both test connections share 15; Redis key prefixes keep the queue
             lists and the cache entries apart. -->
        <env name="REDIS_CACHE_DB" value="15" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
